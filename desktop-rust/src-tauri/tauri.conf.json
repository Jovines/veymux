{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veymux",
  "mainBinaryName": "Veymux",
  "version": "1.4.363",
  "identifier": "com.jovines.veymux",
  "build": {
    "frontendDist": "../.renderer-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'none'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "infoPlist": "Info.plist"
    },
    "icon": [
      "../assets/Veymux.icns",
      ".runtime-icons/icon.png"
    ],
    "resources": {
      "../.workspace-dist/": "workspace/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "requireSignedVersion": true
    }
  }
}
